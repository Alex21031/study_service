# Frontend API target for the merged FastAPI backend.
# If omitted, the web app falls back to http://127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Server-only. Do not prefix with NEXT_PUBLIC.
GEMINI_API_KEY=
GEMINI_STUDY_MODEL=gemini-3-flash-preview

# Server-only local transcription provider.
# Install with: python3 -m pip install git+https://github.com/openai/whisper.git
# Also install ffmpeg locally. On macOS: brew install ffmpeg
WHISPER_PYTHON_BIN=python3
WHISPER_PATH_PREFIX=
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=
WHISPER_CHUNK_SECONDS=600
WHISPER_TIMEOUT_MS=900000
WHISPER_TOTAL_TIMEOUT_MS=7200000

# Optional server-only audio archive storage.
# NCP Object Storage is S3-compatible. Korea endpoint: https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard
NCP_OBJECT_STORAGE_BUCKET=
NCP_OBJECT_STORAGE_ACCESS_KEY=
NCP_OBJECT_STORAGE_SECRET_KEY=
NCP_OBJECT_STORAGE_PREFIX=lectures
