# Web app Firebase config
# Copy this file to apps/web/.env.local for the Next.js workspace.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional emulator host overrides
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Server-only AI integration. For the web app, put these in apps/web/.env.local.
GEMINI_API_KEY=
GEMINI_STUDY_MODEL=gemini-2.5-flash

# Optional server-only transcription provider for Korean lectures.
# Put these in apps/web/.env.local.
NAVER_CLOVA_SPEECH_INVOKE_URL=
NAVER_CLOVA_SPEECH_SECRET=
NAVER_CLOVA_SPEECH_LANGUAGE=ko-KR

# Optional server-only audio archive storage.
# Put these in apps/web/.env.local.
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard
NCP_OBJECT_STORAGE_BUCKET=
NCP_OBJECT_STORAGE_ACCESS_KEY=
NCP_OBJECT_STORAGE_SECRET_KEY=
NCP_OBJECT_STORAGE_PREFIX=lectures
