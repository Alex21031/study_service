# Web app Firebase config
# Copy this file to apps/web/.env.local for the Next.js workspace.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional emulator host overrides
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# Server-only AI integration. For the web app, put these in apps/web/.env.local.
GEMINI_API_KEY=
GEMINI_STUDY_MODEL=gemini-3-flash-preview

# Server-only local transcription provider. For the web app, put these in apps/web/.env.local.
# Install with: python3 -m pip install git+https://github.com/openai/whisper.git
# Also install ffmpeg locally. On macOS: brew install ffmpeg
WHISPER_PYTHON_BIN=python3
WHISPER_PATH_PREFIX=
WHISPER_MODEL=turbo
WHISPER_LANGUAGE=
WHISPER_CHUNK_SECONDS=600
WHISPER_TIMEOUT_MS=900000
WHISPER_TOTAL_TIMEOUT_MS=7200000

# Optional server-only audio archive storage.
# Put these in apps/web/.env.local.
NCP_OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_OBJECT_STORAGE_REGION=kr-standard
NCP_OBJECT_STORAGE_BUCKET=
NCP_OBJECT_STORAGE_ACCESS_KEY=
NCP_OBJECT_STORAGE_SECRET_KEY=
NCP_OBJECT_STORAGE_PREFIX=lectures
